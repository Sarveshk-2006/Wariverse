rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (request.auth.token.role != null ? request.auth.token.role : 'VARKARI');
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || request.auth.token.role == 'ADMIN');
    }
    
    function isRole(targetRole) {
      return isAuthenticated() && (getUserRole() == targetRole || isAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Core Identity & Profiles ─────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && (
        (isOwner(uid) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.volunteer_status != 'APPROVED' &&
         request.resource.data.dindi_leader_status != 'APPROVED' &&
         request.resource.data.sanitation_status != 'APPROVED') ||
        isAdmin()
      );
      allow delete: if isAdmin();
      
      match /emergency_contacts/{contactId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        (isOwner(uid) && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ── NGO Resource Distributions & Aid Coordination ────────────────────────
    match /resource_distributions/{distributionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.ngo_id == request.auth.uid ||
        isRole('NGO') ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.ngo_id == request.auth.uid ||
        isRole('NGO') ||
        isAdmin()
      );
    }

    // ── SOS Incidents Pipeline ───────────────────────────────────────────────
    match /sos_incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.volunteer_enabled == true ||
        isRole('VOLUNTEER') ||
        isRole('MEDICAL_TEAM') ||
        isRole('POLICE') ||
        isRole('NGO') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Legacy path support
    match /realtime/sos/{incidentId} {
      allow read, write: if isAuthenticated();
    }

    // ── Lost Persons Registry ────────────────────────────────────────────────
    match /lost_persons/{personId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.reported_by_uid == request.auth.uid ||
        isRole('POLICE') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Crowd Control & Spatial Analytics ────────────────────────────────────
    match /crowd_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isRole('POLICE') || isAdmin();
    }

    match /crowd_observations/{obsId} {
      allow read: if isAuthenticated();
      allow create, update: if isRole('POLICE') || isAdmin();
      allow delete: if isAdmin();
    }

    match /crowd_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isRole('POLICE') || isAdmin();
      allow delete: if isAdmin();
    }

    // ── CleanWari Sanitation System ──────────────────────────────────────────
    match /toilets/{toiletId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /cleaning_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isRole('CLEANER') || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── NGO Resource Inventory ───────────────────────────────────────────────
    match /resource_inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isRole('NGO') || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Service POI Collections ──────────────────────────────────────────────
    match /food_centres/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /water_points/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /shelters/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /medical_locations/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /wellness_centres/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // ── Community Posts ──────────────────────────────────────────────────────
    match /community_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.author_uid == request.auth.uid || isAdmin());
    }

    // ── Realtime Dindis System ───────────────────────────────────────────────
    match /dindis/{dindiId} {
      allow read: if isAuthenticated();
      allow write: if isRole('DINDI_LEADER') || isAdmin();

      match /location/{docId} {
        allow read: if isAuthenticated();
        allow write: if isRole('DINDI_LEADER') || isAdmin();
      }

      match /community/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isRole('DINDI_LEADER') || isAdmin() || resource.data.author_uid == request.auth.uid;
      }

      match /schedule/{docId} {
        allow read: if isAuthenticated();
        allow write: if isRole('DINDI_LEADER') || isAdmin();
      }
    }
    
    // Legacy dindi realtime path & Virtual Dindi system
    match /realtime/dindis/{dindiId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /virtual_dindis/{dindiId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
