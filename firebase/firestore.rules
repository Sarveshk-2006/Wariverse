rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for security and role isolation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'ADMIN' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }
    
    function isRole(targetRole) {
      return isAuthenticated() && (
        request.auth.token.role == targetRole || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == targetRole || 
        isAdmin()
      );
    }
    
    function isDindiMember(dindiId) {
      return isAuthenticated() && (request.auth.token.dindi_id == dindiId || isAdmin());
    }
    
    function isDindiLeader(dindiId) {
      return isAuthenticated() && ((isRole('DINDI_LEADER') && request.auth.token.dindi_id == dindiId) || isAdmin());
    }

    // Users & User Profiles (Role Escalation Protection)
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
      
      match /emergency_contacts/{contactId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      }
    }

    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Realtime SOS Incident Documents
    match /sos_incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.user_id || 
        isRole('VOLUNTEER') || 
        isRole('MEDICAL_TEAM') || 
        isRole('POLICE') ||
        isRole('NGO') ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.user_id || 
        isRole('VOLUNTEER') || 
        isRole('MEDICAL_TEAM') || 
        isRole('POLICE') ||
        isRole('NGO') ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Infrastructure & Services (Public Read, Authorized Write)
    match /food_centres/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /water_points/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /shelters/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /medical_locations/{id} { allow read: if isAuthenticated(); allow write: if isAdmin() || isRole('MEDICAL_TEAM'); }
    match /toilets/{id} { allow read: if isAuthenticated(); allow write: if isAdmin() || isRole('CLEANER'); }
    match /wellness_centres/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /crowd_zones/{id} { allow read: if isAuthenticated(); allow write: if isAdmin() || isRole('POLICE'); }
    match /lost_persons/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated(); }
    match /community_posts/{id} { allow read: if isAuthenticated(); allow create: if isAuthenticated(); allow update, delete: if isAdmin() || request.auth.uid == resource.data.author_uid; }

    // Realtime Dindi Documents
    match /dindis/{dindiId} {
      allow read: if isAuthenticated();
      allow write: if isDindiLeader(dindiId);
      
      match /location/{updateId} {
        allow read: if isAuthenticated();
        allow write: if isDindiLeader(dindiId);
      }
      
      match /community/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isDindiLeader(dindiId) || request.auth.uid == resource.data.author_uid;
      }
    // Realtime Resource Deployments & Aid Distribution Security Rules
    match /resource_deployments/{deploymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isRole('NGO') || isAdmin()) && request.resource.data.ngo_id == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ngo_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Realtime QR Codes & Scan Logs Security Rules
    match /qr_codes/{qrId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.created_by == request.auth.uid || 
        request.resource.data.owner_id == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.created_by == request.auth.uid || 
        resource.data.owner_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /qr_scan_logs/{scanId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.scanned_by == request.auth.uid;
      allow update, delete: if false; // Audit logs are immutable
    }

    // Virtual Dindis & Intelligent Separation Alert Security Rules
    match /virtual_dindis/{dindiId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.leader_uid == request.auth.uid || 
        isAdmin() ||
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['leader_uid', 'join_code', 'created_at']))
      );
      allow delete: if isAdmin();

      match /members/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (
          uid == request.auth.uid || 
          get(/databases/$(database)/documents/virtual_dindis/$(dindiId)).data.leader_uid == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          uid == request.auth.uid || 
          get(/databases/$(database)/documents/virtual_dindis/$(dindiId)).data.leader_uid == request.auth.uid ||
          isAdmin()
        );
      }

      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false; // Audit logs are immutable
      }

      match /broadcasts/{broadcastId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }
    }

    // Continuous Threat Reporting & Real-Time Incident Response Rules
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        resource.data.reporter_uid == request.auth.uid ||
        resource.data.assigned_volunteer_uid == request.auth.uid ||
        isRole('VOLUNTEER') ||
        isRole('MEDICAL_TEAM') ||
        isRole('POLICE') ||
        isRole('CLEANER') ||
        isRole('NGO') ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.reporter_uid == request.auth.uid ||
        resource.data.assigned_volunteer_uid == request.auth.uid ||
        isRole('VOLUNTEER') ||
        isRole('MEDICAL_TEAM') ||
        isRole('POLICE') ||
        isRole('NGO') ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /reporter_locations/{updateId} {
        allow read, write: if isAuthenticated();
      }

      match /volunteer_locations/{updateId} {
        allow read, write: if isAuthenticated();
      }

      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // Real-Time Location-Based Nearby Services & NGO Deployments
    match /resource_deployments/{deploymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isRole('NGO') || isAdmin());
      allow update: if isAuthenticated() && (resource.data.ngo_id == request.auth.uid || isRole('NGO') || isAdmin());
      allow delete: if isAdmin();
    }

    match /food_centres/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /water_points/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /shelters/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /medical_locations/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /toilets/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /wellness_centres/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    match /virtual_dindis/{dindiId} {
      allow read, write: if isAuthenticated();

      match /broadcasts/{broadcastId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isRole('DINDI_LEADER') || isAdmin() || request.auth.uid == get(/databases/$(database)/documents/virtual_dindis/$(dindiId)).data.leader_user_id);
      }

      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isRole('DINDI_LEADER') || isAdmin() || request.auth.uid == get(/databases/$(database)/documents/virtual_dindis/$(dindiId)).data.leader_user_id);
      }

      match /community_messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (resource.data.author_id == request.auth.uid || isAdmin());
      }
    }
  }
}
